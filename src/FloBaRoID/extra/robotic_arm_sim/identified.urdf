  <ns0:unless value="${'$(arg hardware)' == 'mujoco'}">
  <ros2_control name="arm_hw" type="system">
    <hardware>
      <plugin>arm_controller/ArmRealInterfaces</plugin>
      <!-- loopback=true &#26102;&#36339;&#36807; USB &#25171;&#24320;&#12289;&#25226;&#25351;&#20196;&#35835;&#22238;&#29366;&#24577;&#65292;&#21482;&#29992;&#20110;&#26080;&#30828;&#20214;&#20882;&#28895;&#12290; -->
      <param name="loopback">$(arg loopback)</param>
      <!-- &#36229;&#36807;&#35813;&#26102;&#38271;&#27809;&#25910;&#21040; MCU &#29366;&#24577;&#21253;&#23601;&#36820;&#22238; ERROR&#65292;&#35753; controller_manager &#20572;&#25511;&#21046;&#22120;&#12290; -->
      <param name="state_timeout_ms">100</param>
      <!-- &#20851;&#33410;&#26631;&#23450;&#34920;&#65306;q_urdf = dir * (q_raw - zero)&#12290;&#22266;&#20214;&#38646;&#20301;&#19982; URDF &#30340; SolidWorks
           &#38646;&#20301;&#27809;&#26377;&#20849;&#21516;&#22522;&#20934;&#65292;&#24517;&#39035;&#29616;&#22330;&#26631;&#23450;&#65307;&#26410;&#26631;&#23450;&#26102;&#25991;&#20214;&#37324;&#26159; dir=1/zero=0 &#30340;&#21344;&#20301;&#20540;&#12290; -->
      <param name="joint_calibration_file">$(find arm_controller)/config/joint_calibration.yaml</param>
    </hardware>

    <joint name="joint1">
      <!-- &#19979;&#20301;&#26426;&#22266;&#20214;&#21482;&#25509;&#25910;&#20301;&#32622;/&#36895;&#24230;/&#21147;&#30697;&#21069;&#39304;&#65292;kp/kd/ki **&#19981;&#20250;**&#19978;&#24635;&#32447;
           &#65288;&#22266;&#20214;&#36305;&#33258;&#24049;&#30340;&#20301;&#32622;/&#36895;&#24230;&#21452;&#29615; PID&#65289;&#12290;&#20445;&#30041;&#36825;&#19977;&#20010;&#25509;&#21475;&#21482;&#26159;&#20026;&#20102;&#28385;&#36275;
           ArmController &#30340;&#21629;&#20196;&#25509;&#21475;&#22768;&#26126;&#65292;&#20540;&#22312; ArmRealInterfaces::write &#37324;&#34987;&#20002;&#24323;&#12290; -->
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="ki" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />

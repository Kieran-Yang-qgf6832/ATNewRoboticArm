<?xml version='1.0' encoding='us-ascii'?>
<robot xmlns:ns0="http://www.ros.org/wiki/xacro" name="robotic_arm">

  
  <ns0:arg name="headless" default="false" />
  
  <ns0:arg name="hardware" default="mujoco" />
  
  <ns0:arg name="loopback" default="false" />

  <ns0:if value="${'$(arg hardware)' == 'mujoco'}">
  <ros2_control name="arm_hw" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(find arm_model)/model/scene.xml</param>
      
      <param name="headless">$(arg headless)</param>
    </hardware>

    <joint name="joint1">
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

    <joint name="joint2">
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

    <joint name="joint3">
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

    <joint name="joint4">
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

    <joint name="joint5">
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

    <joint name="joint6">
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

  </ros2_control>
  </ns0:if>

  <ns0:unless value="${'$(arg hardware)' == 'mujoco'}">
  <ros2_control name="arm_hw" type="system">
    <hardware>
      <plugin>arm_controller/ArmRealInterfaces</plugin>
      
      <param name="loopback">$(arg loopback)</param>
      
      <param name="state_timeout_ms">100</param>
      
      <param name="joint_calibration_file">$(find arm_controller)/config/joint_calibration.yaml</param>
    </hardware>

    <joint name="joint1">
      
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="ki" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

    <joint name="joint2">
      
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="ki" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

    <joint name="joint3">
      
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="ki" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

    <joint name="joint4">
      
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="ki" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

    <joint name="joint5">
      
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="ki" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

    <joint name="joint6">
      
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <command_interface name="ki" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      
      <state_interface name="acceleration" />
    </joint>

  </ros2_control>
  </ns0:unless>
  
  <link name="world" />
  <joint name="world_to_base" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0091691 0.00025382 0.018962" rpy="0 0 0" />
      <mass value="1.0998" />
      <inertia ixx="0.0018714" ixy="5.0546e-06" ixz="8.499199999993374e-08" iyy="0.0021258000000000006" iyz="1.3828000000000116e-07" izz="0.0039568" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.29412 0.29412 0.29412 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link name="link1">
    <inertial>
      <origin xyz="7.43358623475285e-06 0.023889111022454 0.0983534461817423" rpy="0 0 0" />
      <mass value="2.34956808405639" />
      <inertia ixx="0.005738754846765018" ixy="-2.0035739776001403e-07" ixz="1.0549933806054903e-06" iyy="0.008145963720907697" iyz="2.405432119780438e-05" izz="0.00840985861180689" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link1.STL" />
      </geometry>
      <material name="">
        <color rgba="0.294117647058824 0.294117647058824 0.294117647058824 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link1.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link1" />
    <axis xyz="0 0 1" />
    <limit lower="-1.8" upper="1.8" effort="50" velocity="10" />
  <dynamics friction="0.05" damping="0.1" /></joint>
  <link name="link2">
    <inertial>
      <origin xyz="0.31324601008515 -0.000831742439412309 0.0364273369229759" rpy="0 0 0" />
      <mass value="1.23727124080295" />
      <inertia ixx="0.0005746985705467149" ixy="6.786188447384161e-07" ixz="6.528270716803578e-05" iyy="0.0139530728630749" iyz="1.730229392180739e-06" izz="0.01421130561792247" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link2.STL" />
      </geometry>
      <material name="">
        <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link2.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0.03675 0.153" rpy="1.5708 -1.5708 0" />
    <parent link="link1" />
    <child link="link2" />
    <axis xyz="0 0 1" />
    <limit lower="-1.570796327" upper="1.570796327" effort="50" velocity="10" />
  <dynamics friction="0.05" damping="0.1" /></joint>
  <link name="link3">
    <inertial>
      <origin xyz="0.271920716707995 -0.000176719212418436 -0.0120138921627069" rpy="0 0 0" />
      <mass value="0.370266089775016" />
      <inertia ixx="0.000130367133133288" ixy="6.890458000745175e-07" ixz="-1.9489994210807136e-06" iyy="0.002676748906030202" iyz="-1.7332822177274496e-07" izz="0.00278032819630172" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link3.STL" />
      </geometry>
      <material name="">
        <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link3.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin xyz="0.52 0 0.08565" rpy="0 0 0" />
    <parent link="link2" />
    <child link="link3" />
    <axis xyz="0 0 1" />
    <limit lower="-2.9" upper="2.9" effort="50" velocity="10" />
  <dynamics friction="0.05" damping="0.1" /></joint>
  <link name="link4">
    <inertial>
      <origin xyz="0.101739291148925 0.0561668504993356 -0.0293841566997596" rpy="0 0 0" />
      <mass value="1.54177209165349" />
      <inertia ixx="0.0008890422990252894" ixy="-2.009793011448907e-06" ixz="1.1456064995118628e-05" iyy="0.0009027538667661442" iyz="4.2513174915333185e-08" izz="0.00027000037105293084" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link4.STL" />
      </geometry>
      <material name="">
        <color rgba="0.294117647058824 0.294117647058824 0.294117647058824 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link4.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin xyz="0.436 0 0.0225" rpy="0 0 0" />
    <parent link="link3" />
    <child link="link4" />
    <axis xyz="0 0 1" />
    <limit lower="-2.0" upper="1.8" effort="50" velocity="10" />
  <dynamics friction="0.05" damping="0.1" /></joint>
  <link name="link5">
    <inertial>
      <origin xyz="0.0486576553457728 0.00239487174403753 0.00012705522061713" rpy="0 0 0" />
      <mass value="0.0698721570199944" />
      <inertia ixx="1.56377401050224e-05" ixy="-2.1260488027985736e-07" ixz="-4.605741650695258e-21" iyy="1.977863340578824e-05" iyz="2.6734477397713854e-21" izz="2.2600795629979333e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link5.STL" />
      </geometry>
      <material name="">
        <color rgba="0.294117647058824 0.294117647058824 0.294117647058824 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link5.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin xyz="0.07761 -0.0058889 -0.03035" rpy="-1.5708 0 0" />
    <parent link="link4" />
    <child link="link5" />
    <axis xyz="0 0 1" />
    <limit lower="-0.610865238" upper="0.610865238" effort="50" velocity="10" />
  <dynamics friction="0.05" damping="0.1" /></joint>
  <link name="link6">
    <inertial>
      <origin xyz="1.1369377661552e-14 3.51232931627976e-13 0.0193009014981094" rpy="0 0 0" />
      <mass value="0.128099358994803" />
      <inertia ixx="6.476967318384781e-05" ixy="9.75275553763421e-22" ixz="-2.3260009659370655e-21" iyy="6.476967318384781e-05" iyz="-1.8634724839594607e-20" izz="9.58412456894771e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link6.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arm_model/model/link6.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint6" type="revolute">
    <origin xyz="0.073796 0.0036822 8.8922E-05" rpy="0 -1.5708 3.14" />
    <parent link="link5" />
    <child link="link6" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="10" />
  <dynamics friction="0.05" damping="0.1" /></joint>
</robot>
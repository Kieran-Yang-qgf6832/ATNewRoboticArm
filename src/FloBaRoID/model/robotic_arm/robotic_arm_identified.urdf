      <state_interface name="effort" />
      <!-- &#30495;&#23454;&#20851;&#33410;&#21152;&#36895;&#24230;&#65306;mujoco_ros2_control &#20174; qacc &#23548;&#20986;&#65292;&#21442;&#25968;&#36776;&#35782;&#29992;&#23427;&#26367;&#20195;
           "&#23545;&#35760;&#24405;&#36895;&#24230;&#20108;&#27425;&#27714;&#23548;"&#65288;docs/bugs.md O8&#65289;&#12290; -->

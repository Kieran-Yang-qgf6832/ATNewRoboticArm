<?xml version='1.0' encoding='us-ascii'?>
<robot xmlns:ns0="http://www.ros.org/wiki/xacro" name="robotic_arm">

  <!-- headless&#65306;&#26159;&#21542;&#20851;&#25481; MuJoCo &#33258;&#24102;&#30340; UI &#31383;&#21475;&#65292;&#32431;&#21629;&#20196;&#34892;&#36305;&#20223;&#30495;&#65288;&#27979;&#37327;/&#25209;&#22788;&#29702;&#29992;&#65289;&#12290;
       &#40664;&#35748; false = &#20445;&#30041; UI&#12290;launch &#29992; xacro &#20256; headless:=true &#25171;&#24320;&#12290;
       &#27880;&#24847;&#65306;&#26412;&#25991;&#20214;&#21516;&#26102;&#34987; pinocchio &#24403;**&#32431; URDF** &#35299;&#26512;&#65288;identify_arm / &#28608;&#21169;&#36712;&#36857;&#29983;&#25104;&#65289;&#65292;
       pinocchio &#20250;&#24573;&#30053; <ros2_control> &#25972;&#22359;&#21644; xacro &#20803;&#32032;&#65292;&#25152;&#20197;&#36825;&#37324;&#21152; xacro &#26159;&#23433;&#20840;&#30340;&#65307;
       &#20294;&#19981;&#35201;&#22312;&#36825;&#37324;&#20889;&#20250;&#24433;&#21709;&#36816;&#21160;&#23398;&#30340; $(arg ...)&#12290; -->
  <ns0:arg name="headless" default="false" />
  <!-- hardware&#65306;&#36873;&#25321; ros2_control &#30828;&#20214;&#25554;&#20214;&#12290;mujoco&#65288;&#40664;&#35748;&#65289;= MuJoCo &#20223;&#30495;&#65292;
       real = &#23454;&#26426; USB CDC &#25509;&#21475;&#12290;&#21482;&#20999;&#25442; <ros2_control> &#22359;&#65292;&#36816;&#21160;&#23398;&#23436;&#20840;&#20849;&#29992;&#65307;
       pinocchio &#35299;&#26512;&#26102;&#25972;&#22359;&#34987;&#24573;&#30053;&#65292;&#22240;&#27492;&#19981;&#24433;&#21709;&#25511;&#21046;&#22120;&#20869;&#37096;&#30340;&#27169;&#22411;&#12290; -->
  <ns0:arg name="hardware" default="mujoco" />
  <!-- loopback&#65306;&#23454;&#26426;&#25509;&#21475;&#30340;&#26412;&#22320;&#22238;&#29615;&#65292;&#19981;&#25171;&#24320; USB &#35774;&#22791;&#65292;&#21482;&#29992;&#20110;&#26080;&#30828;&#20214;&#20882;&#28895;&#12290;
       &#40664;&#35748; false&#65307;&#25509;&#30495;&#26426;&#26102;&#24517;&#39035;&#20445;&#25345; false&#12290; -->
  <ns0:arg name="loopback" default="false" />

  <ns0:if value="${'$(arg hardware)' == 'mujoco'}">
  <ros2_control name="arm_hw" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(find arm_model)/model/scene.xml</param>

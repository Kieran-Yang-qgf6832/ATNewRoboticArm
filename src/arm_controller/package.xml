<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_controller</name>
  <version>0.0.0</version>
  <description>Core control package for the 6-DOF robotic arm: controller-side FSM (ArmController), chained PID for simulation (SimPidController) and the real-hardware USB CDC interface (ArmRealInterfaces), plus Pinocchio-based kinematics/dynamics solvers.</description>
  <maintainer email="cloud1202@qq.com">lyz</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>libusb-1.0</depend>
  <depend>eigen</depend>
  <depend>robot_msgs</depend>
  <depend>std_msgs</depend>
  <depend>kdl_parser</depend>
  <depend>orocos_kdl</depend>
  <depend>pinocchio</depend>
  <!-- O12：pinocchio 的碰撞/距离查询底层是 coal（hpp-fcl 的继任者）。 -->
  <depend>coal</depend>
  <depend>ament_index_cpp</depend>
  <depend>arm_model</depend>
  <!-- 关节标定文件（joint_calibration.yaml）解析 -->
  <depend>yaml-cpp</depend>
  <depend>yaml_cpp_vendor</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_base_motion</name>
  <version>0.1.0</version>
  <description>
    基座运动补偿 / 末端惯性空间保持的仿真侧支撑：MuJoCo 基座驱动插件（脚本化 mocap
    运动 + BaseMotionState 话题）、world→base_link 动态 TF 节点、浮动基座 MJCF 生成脚本、
    误差统计脚本与一键 launch。
  </description>
  <maintainer email="fanziqi614@gmail.com">Ziqi Fan</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>robot_msgs</depend>
  <depend>mujoco_vendor</depend>
  <depend>mujoco_ros2_control_plugins</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>arm_model</exec_depend>
  <exec_depend>launch_pack</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

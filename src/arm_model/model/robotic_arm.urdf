<!-- 2026-11-14：实机机械臂换代，本文件的 link / joint / 惯量 / 限位 / 轴全部
     来自新一代 CAD 导出，替换了旧一代模型。两处刻意与导出值不同：
     1) <limit effort> 统一 50 N·m：导出值 100 是 SolidWorks 默认值，
        ros2_controller.yaml 的 torque_limit_rate 就是按 50 N·m 折算力矩门禁的；
     2) mesh 前缀用 package://arm_model/model/（导出为 package://arm/，本仓库没有 arm 包）。
     另外 joint2/joint3/joint4 的轴为 0 0 -1、joint5 轴相对工具 z 倾斜 3.28°，
     均为 CAD 原值，未做规范化。背景见 docs/adr/2026-11-14/1546-机械臂模型换代.md。 -->
<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="robotic_arm">

  <!-- headless：是否关掉 MuJoCo 自带的 UI 窗口，纯命令行跑仿真（测量/批处理用）。
       默认 false = 保留 UI。launch 用 xacro 传 headless:=true 打开。
       注意：本文件同时被 pinocchio 当**纯 URDF** 解析（identify_arm / 激励轨迹生成），
       pinocchio 会忽略 <ros2_control> 整块和 xacro 元素，所以这里加 xacro 是安全的；
       但不要在这里写会影响运动学的 $(arg ...)。 -->
  <xacro:arg name="headless" default="false"/>
  <!-- hardware：选择 ros2_control 硬件插件。mujoco（默认）= MuJoCo 仿真，
       real = 实机 USB CDC 接口。只切换 <ros2_control> 块，运动学完全共用；
       pinocchio 解析时整块被忽略，因此不影响控制器内部的模型。 -->
  <xacro:arg name="hardware" default="mujoco"/>
  <!-- loopback：实机接口的本地回环，不打开 USB 设备，只用于无硬件冒烟。
       默认 false；接真机时必须保持 false。 -->
  <xacro:arg name="loopback" default="false"/>
  <!-- mujoco_model：MuJoCo 加载的 MJCF 场景。默认 scene.xml（辨识/测量共用）；
       视觉验证时由 launch 传 scene_vision.xml（多一台相机和一个红色目标箱）。
       只影响仿真硬件块，实机与 pinocchio 解析都不读它。 -->
  <xacro:arg name="mujoco_model" default="$(find arm_model)/model/scene.xml"/>

  <xacro:if value="${'$(arg hardware)' == 'mujoco'}">
  <ros2_control name="arm_hw" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(arg mujoco_model)</param>
      <!-- mujoco_ros2_control 的硬件参数：headless=true 时用 HeadlessAdapter 代替 GLFW，
           不开窗口、不跑渲染线程，物理线程照常推进。 -->
      <param name="headless">$(arg headless)</param>
    </hardware>

    <joint name="joint1">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- 真实关节加速度：mujoco_ros2_control 从 qacc 导出，参数辨识用它替代
           "对记录速度二次求导"（docs/bugs.md O8）。 -->
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint2">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- 真实关节加速度：mujoco_ros2_control 从 qacc 导出，参数辨识用它替代
           "对记录速度二次求导"（docs/bugs.md O8）。 -->
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint3">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- 真实关节加速度：mujoco_ros2_control 从 qacc 导出，参数辨识用它替代
           "对记录速度二次求导"（docs/bugs.md O8）。 -->
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint4">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- 真实关节加速度：mujoco_ros2_control 从 qacc 导出，参数辨识用它替代
           "对记录速度二次求导"（docs/bugs.md O8）。 -->
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint5">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- 真实关节加速度：mujoco_ros2_control 从 qacc 导出，参数辨识用它替代
           "对记录速度二次求导"（docs/bugs.md O8）。 -->
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint6">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- 真实关节加速度：mujoco_ros2_control 从 qacc 导出，参数辨识用它替代
           "对记录速度二次求导"（docs/bugs.md O8）。 -->
      <state_interface name="acceleration"/>
    </joint>

  </ros2_control>
  </xacro:if>

  <xacro:unless value="${'$(arg hardware)' == 'mujoco'}">
  <ros2_control name="arm_hw" type="system">
    <hardware>
      <plugin>arm_controller/ArmRealInterfaces</plugin>
      <!-- loopback=true 时跳过 USB 打开、把指令读回状态，只用于无硬件冒烟。 -->
      <param name="loopback">$(arg loopback)</param>
      <!-- 超过该时长没收到 MCU 状态包就返回 ERROR，让 controller_manager 停控制器。 -->
      <param name="state_timeout_ms">100</param>
      <!-- 关节标定表：q_urdf = dir * (q_raw - zero)。固件零位与 URDF 的 SolidWorks
           零位没有共同基准，必须现场标定；未标定时文件里是 dir=1/zero=0 的占位值。 -->
      <param name="joint_calibration_file">$(find arm_controller)/config/joint_calibration.yaml</param>
    </hardware>

    <joint name="joint1">
      <!-- 下位机固件只接收位置/速度/力矩前馈，kp/kd/ki **不会**上总线
           （固件跑自己的位置/速度双环 PID）。保留这三个接口只是为了满足
           ArmController 的命令接口声明，值在 ArmRealInterfaces::write 里被丢弃。 -->
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <command_interface name="ki"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- MCU 不上报加速度；接口导出恒 0，满足控制器对 acceleration 的请求。 -->
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint2">
      <!-- 下位机固件只接收位置/速度/力矩前馈，kp/kd/ki **不会**上总线
           （固件跑自己的位置/速度双环 PID）。保留这三个接口只是为了满足
           ArmController 的命令接口声明，值在 ArmRealInterfaces::write 里被丢弃。 -->
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <command_interface name="ki"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- MCU 不上报加速度；接口导出恒 0，满足控制器对 acceleration 的请求。 -->
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint3">
      <!-- 下位机固件只接收位置/速度/力矩前馈，kp/kd/ki **不会**上总线
           （固件跑自己的位置/速度双环 PID）。保留这三个接口只是为了满足
           ArmController 的命令接口声明，值在 ArmRealInterfaces::write 里被丢弃。 -->
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <command_interface name="ki"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- MCU 不上报加速度；接口导出恒 0，满足控制器对 acceleration 的请求。 -->
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint4">
      <!-- 下位机固件只接收位置/速度/力矩前馈，kp/kd/ki **不会**上总线
           （固件跑自己的位置/速度双环 PID）。保留这三个接口只是为了满足
           ArmController 的命令接口声明，值在 ArmRealInterfaces::write 里被丢弃。 -->
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <command_interface name="ki"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- MCU 不上报加速度；接口导出恒 0，满足控制器对 acceleration 的请求。 -->
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint5">
      <!-- 下位机固件只接收位置/速度/力矩前馈，kp/kd/ki **不会**上总线
           （固件跑自己的位置/速度双环 PID）。保留这三个接口只是为了满足

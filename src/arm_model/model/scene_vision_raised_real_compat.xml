<mujoco model="robotic_arm_vision_scene_raised_real_compat">
  <!--
    抬高视觉场景的实机兼容变体：箱体/相机 z=0.6（同 scene_vision_raised.xml），
    并把 joint6 锁死在 0（同 scene_real_compat.xml）。

    用途：在 5 自由度下验收 box_move（位置 + 工具轴 5 维 + 视觉）。
    相机安装位姿仍只在本文件定义一次，view_sim.launch.py 的 scene_path 必须指向
    同一个文件，否则 TF 与渲染会不一致。
  -->
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <include file="robotic_arm_real_compat.xml"/>

  <statistic center="0.55 0 0.6" extent="1.5"/>

  <visual>
    <headlight diffuse="0.2 0.2 0.2" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0 0 0 0"/>
    <global offwidth="1920" offheight="1080"/>
  </visual>

  <default>
    <geom group="2" rgba="0.5 0.5 0.9 0.35"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.55 0.75" rgb2="0.05 0.08 0.1" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.25 0.3" rgb2="0.12 0.16 0.2"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" size="50 50 0.3" pos="0 0 0" material="groundplane" contype="1" conaffinity="1"/>
    <light name="main_light" pos="0 0 4" dir="0 0 -1" directional="true"/>

    <!-- 抬高后的相机：与箱心 (0.75, 0.09, 0.6) 同高，光轴水平指向箱心。 -->
    <camera name="vision_camera" pos="0 0.24 0.6"
            xyaxes="-0.18429 -0.98288 0  0 0 1"
            fovy="60" resolution="640 480"/>

    <!-- 抬高后的红色立方体：边长 0.35 m，中心 (0.75, 0.09, 0.6)，绕 z 逆时针 31°。 -->
    <geom name="red_box" type="box" size="0.175 0.175 0.175"
          pos="0.75 0.09 0.6" quat="0.963630 0 0 0.267238"
          rgba="1 0 0 1" group="0"/>
  </worldbody>

  <!-- joint6 无电机：约束 q1 = 0（polycoef[1]=1，全 0 等于没有约束）。 -->
  <equality>
    <joint name="joint6_locked" joint1="joint6" polycoef="0 1 0 0 0"
           solref="0.002 1" solimp="0.99 0.999 0.001"/>
  </equality>
</mujoco>

<?xml version="1.0" encoding="utf-8"?>
<!-- This URDF was automatically created by SolidWorks to URDF Exporter! Originally created by Stephen Brawner (brawner@gmail.com)
     Commit Version: 1.6.0-4-g7f85cfe  Build Version: 1.6.7995.38578
     For more information, please see http://wiki.ros.org/sw_urdf_exporter -->
<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="robotic_arm">

  <!--
    ==========================================================================
    当前生效模型：4 自由度机械臂
    ==========================================================================
    几何/惯量/关节限位/网格全部来自这台 4 自由度臂自己的数据（robotic_arm.csv 是
    SolidWorks 导出的原始表）；    接口层（ros2_control 硬件块、headless 参数、虚拟根
    link）沿用 6 自由度模型（Git commit 5e59ef5）的写法，使控制器链路不需要任何改动：

      ArmController → SimPidController → mujoco_ros2_control/MujocoSystem

    hardware:=real 时换成实机块：ArmController → ArmRealInterfaces → USB CDC → MCU。
    4 轴实机只有 4 个电机，motor_count=4 把 URDF 的 joint1..joint4 映射到 MCU 帧的
    前 4 个槽位；第 5/6 槽保持不动（见 arm_real_interfaces.cpp 的 write()）。

    注意：本文件同时被 pinocchio 当**纯 URDF** 解析（identify_arm / 激励轨迹生成），
    pinocchio 会忽略 <ros2_control> 整块和 xacro 元素，所以这里加 xacro 是安全的；
    但不要在这里写会影响运动学的 $(arg ...)。
    ==========================================================================
  -->
  <xacro:arg name="headless" default="false"/>
  <!-- hardware：选择 ros2_control 硬件插件。mujoco（默认）= MuJoCo 仿真，
       real = 实机 USB CDC 接口。只切换 <ros2_control> 块，运动学完全共用；
       pinocchio 解析时整块被忽略，因此不影响控制器内部的模型。 -->
  <xacro:arg name="hardware" default="mujoco"/>
  <!-- loopback：实机接口的本地回环，不打开 USB 设备，只用于无硬件冒烟。
       默认 false；接真机时必须保持 false。 -->
  <xacro:arg name="loopback" default="false"/>
  <!-- mujoco_model：MuJoCo 加载的 MJCF 场景。默认 scene.xml（辨识/测量共用）；
       视觉验证时由 launch 传 scene_vision.xml。只影响仿真硬件块。 -->
  <xacro:arg name="mujoco_model" default="$(find arm_model)/model_4dof/scene.xml"/>

  <xacro:if value="${'$(arg hardware)' == 'mujoco'}">
  <ros2_control name="arm_hw" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(arg mujoco_model)</param>
      <!-- mujoco_ros2_control 的硬件参数：headless=true 时用 HeadlessAdapter 代替 GLFW，
           不开窗口、不跑渲染线程，物理线程照常推进。 -->
      <param name="headless">$(arg headless)</param>
    </hardware>


    <joint name="joint1">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- 真实关节加速度：mujoco_ros2_control 从 qacc 导出，参数辨识用它替代
           "对记录速度二次求导"（docs/bugs.md O8）。 -->
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint2">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint3">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint4">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="acceleration"/>
    </joint>

  </ros2_control>
  </xacro:if>

  <!-- hardware:=real：实机 USB CDC 接口。接口名与 6 轴模型的实机块一致，控制器层
       不需要区分轴数；关节数由 <ros2_control> 里列出的 joint 决定。 -->
  <xacro:unless value="${'$(arg hardware)' == 'mujoco'}">
  <ros2_control name="arm_hw" type="system">
    <hardware>
      <plugin>arm_controller/ArmRealInterfaces</plugin>
      <!-- loopback=true 时跳过 USB 打开、把指令读回状态，只用于无硬件冒烟。 -->
      <param name="loopback">$(arg loopback)</param>
      <!-- 超过该时长没收到 MCU 状态包就返回 ERROR，让 controller_manager 停控制器。 -->
      <param name="state_timeout_ms">100</param>
      <!-- 实际驱动的电机数：4 轴硬件只有 4 个电机，占用 MCU 帧（固定 6 槽）的前 4 槽。
           第 5/6 槽不发新目标，见 arm_real_interfaces.cpp 的 write()。 -->
      <param name="motor_count">4</param>
      <!-- 关节标定表：q_urdf = dir * (q_raw - zero)。固件零位与 URDF 的 SolidWorks
           零位没有共同基准，必须现场标定；未标定时文件里是 dir=1/zero=0 的占位值。 -->
      <param name="joint_calibration_file">$(find arm_controller)/config/joint_calibration_4dof.yaml</param>
    </hardware>

    <joint name="joint1">
      <!-- 固件只接收位置/速度/力矩前馈，kp/kd/ki **不会**上总线（固件跑自己的
           位置/速度双环 PID）。保留这三个接口只是为了满足 ArmController 的声明。 -->
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <command_interface name="ki"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- MCU 不上报加速度；接口导出恒 0，满足控制器对 acceleration 的请求。 -->
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <command_interface name="ki"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <command_interface name="ki"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="acceleration"/>
    </joint>

    <joint name="joint4">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <command_interface name="ki"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="acceleration"/>
    </joint>

  </ros2_control>
  </xacro:unless>

  <!-- 虚拟根链接，解决 KDL 根链接惯量问题：base_link 有质量，当 URDF 根时 kdl_parser
       会刷 "root link has an inertia" 警告并丢掉这份惯量；加一个无惯量的 world 当根、
       再用固定关节接到 base_link，警告消失，且与 MJCF 的 worldbody 结构对齐。 -->
  <link name="world" />
  <joint
    name="world_to_base"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="world" />
    <child
      link="base_link" />
  </joint>
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-9.27036225562006E-15 7.38592952492789E-07 0.0155299485832002"
        rpy="0 0 0" />
      <mass
        value="0.445927939104524" />
      <inertia
        ixx="0.000224769873618828"
        ixy="-2.18020596913895E-10"
        ixz="-5.52265481609804E-19"
        iyy="0.00138253371851121"
        iyz="-2.51299344174685E-20"
        izz="0.00122838375537572" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://arm_model/model_4dof/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.866666666666667 0.909803921568627 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://arm_model/model_4dof/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="joint1"
    type="revolute">
    <origin
      xyz="0 0.042 0.05"
      rpy="1.5708 -1.5708 0.0" />
    <parent
      link="base_link" />
    <child
      link="link1" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-1.5708"
      upper="1.5708"
      effort="50"
      velocity="10" />
  </joint>
  <link
    name="link1">
    <inertial>
      <origin
        xyz="0.163587015176246 0.000202798582474142 0.0350397770187157"
        rpy="0 0 0" />
      <mass
        value="0.422761931253973" />
      <inertia
        ixx="5.69493202543751E-05"
        ixy="-2.03221997946206E-06"
        ixz="-8.63264983106718E-08"
        iyy="0.00242791349103459"
        iyz="-2.59016529851239E-09"
        izz="0.00245118578495609" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://arm_model/model_4dof/link1.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://arm_model/model_4dof/link1.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="joint2"
    type="revolute">
    <origin
      xyz="0.374 0 0.0401"
      rpy="1.5708 0 0" />
    <parent
      link="link1" />
    <child
      link="link2" />
    <axis
      xyz="0 -1 0" />
    <limit
      lower="-3.1"
      upper="3.1"
      effort="50"
      velocity="10" />
  </joint>
  <link
    name="link2">
    <inertial>
      <origin
        xyz="0.258483690032714 -0.00550281148638793 2.4003006262735E-06"
        rpy="0 0 0" />
      <mass
        value="0.352210008949705" />
      <inertia
        ixx="0.00011115230760041"
        ixy="-8.45752275895149E-09"
        ixz="5.15122491760907E-09"
        iyy="0.000603852596441218"
        iyz="-1.29037854530489E-07"
        izz="0.000587657443623324" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://arm_model/model_4dof/link2.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.87843137254902 0 0.129411764705882 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://arm_model/model_4dof/link2.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="joint3"
    type="revolute">
    <origin
      xyz="0.4014 -0.0055 0"
      rpy="0 0 0" />
    <parent
      link="link2" />
    <child
      link="link3" />
    <axis
      xyz="1 0 0" />
    <limit
      lower="-3.14"
      upper="3.14"
      effort="50"
      velocity="10" />
  </joint>
  <link
    name="link3">
    <inertial>
      <origin
        xyz="0.0356914460529407 -0.0127290421616784 -4.99847735601633E-05"
        rpy="0 0 0" />
      <mass
        value="0.0763832349061947" />
      <inertia
        ixx="2.30975481800775E-05"
        ixy="-3.96632725546314E-07"
        ixz="1.43784025932649E-09"
        iyy="3.02654097799572E-05"
        iyz="4.53169889578176E-08"
        izz="2.62744379783613E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://arm_model/model_4dof/link3.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.866666666666667 0.909803921568627 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://arm_model/model_4dof/link3.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="joint4"
    type="revolute">
    <origin
      xyz="0.0430000000000001 -0.0199999999998909 0"
      rpy="1.5707963267949 0 3.14159265358979" />
    <parent
      link="link3" />
    <child
      link="link4" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-1.5708"
      upper="1.5708"
      effort="50"
      velocity="10" />
  </joint>
  <link
    name="link4">
    <inertial>
      <origin
        xyz="-0.0725200807880995 0.0116284521818822 0.0206751464031625"
        rpy="0 0 0" />
      <mass
        value="0.267547364804174" />
      <inertia
        ixx="0.000159517801401972"
        ixy="7.59248239536197E-08"
        ixz="-5.5601365856691E-08"
        iyy="0.000127171807362423"
        iyz="2.51609951433807E-07"
        izz="0.000155060226944876" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://arm_model/model_4dof/link4.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.847058823529412 0.847058823529412 0.847058823529412 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://arm_model/model_4dof/link4.STL" />
      </geometry>
    </collision>
  </link>
</robot>

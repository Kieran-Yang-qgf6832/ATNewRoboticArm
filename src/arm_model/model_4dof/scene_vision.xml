<mujoco model="robotic_arm_vision_scene">
  <!--
    4 轴视觉验证场景：scene.xml + 一台固定相机 + 一个红色目标箱。

    刻意与 scene.xml 分开：scene.xml 同时被参数辨识（arm_measure_sim.launch.py）使用，
    往里面加一个可碰撞箱子会让激励轨迹在它不知道的情况下撞上去，接触冲量会直接污染
    辨识数据（见 docs/bugs/2026-10-13/2226-激励轨迹撞地面污染辨识.md）。

    相机安装位姿只在本文件定义一次：view_sim.launch.py 启动时直接解析下面的
    <camera> 元素（pos + xyaxes）生成 TF，渲染与算法用的是同一串数字。

    MuJoCo 相机约定：X 右、Y 上、光轴沿 -Z。这里相机 X = 世界 +x、Y = 世界 +z，
    光轴 -Z = 世界 +y，正对箱体的两个可见面（-X' 与 -Y'），每个面入射 45°。
    ROS 光学帧（X 右、Y 下、Z 前）与相机帧差一个绕 X 的 180°，由 view_sim.launch.py
    的第二段静态 TF 固定承担，本文件不掺和。

    箱体位置由 4 轴运动学反推，不是随手拍的数：
      - 末端 link4 原点的 y 只能在 -0.0126 ~ +0.0274（joint3 滚转贡献，与 x/z 无关）；
      - link4 工具沿 +z 最远 0.062 m，故可见面只能落在 y ≈ 0.057 ~ 0.097；
      - 取 yaw 45°、可抓面心 (0.2265, 0.0595, 0.175)，面法线 (-0.707, -0.707, 0)，
        任务侧 tool_offset 0.07 → 末端目标 (0.177, 0.010, 0.175)，落在可达带内；
      - 该位姿在 25 个随机 IK 种子里有 28 组「无碰撞 (q, q4)」解，正交面
        （法线 (0.707, -0.707, 0)）同一扫描为 0 组——link2 会扫过箱体。
      - 相机放在 -x 一侧（x=0.05）而不是正对箱心：45° 箱体两个侧面都朝 -y 时，
        追踪器实测锁到了 +x 侧那一面（首次端到端 residual 0.2175 m，那一面 IK 无解）。
        相机偏到 -x 后，可抓面入射 28.8°，另一面升到 79.9° 超过 65° 门限被拒，
        锁定面唯一且正好是可抓的那一面（检测模式 single）。
        注意：正方形绕 z 旋转 ±45° 的角点完全一样，换个 yaw 符号并不能改变可见性。
  -->
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <include file="robotic_arm.xml"/>

  <statistic center="0.35 -0.1 0.3" extent="1.4"/>

  <visual>
    <headlight diffuse="0.2 0.2 0.2" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0 0 0 0"/>
    <global offwidth="1920" offheight="1080"/>
  </visual>

  <default>
    <geom group="2" rgba="0.5 0.5 0.9 0.35"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.55 0.75" rgb2="0.05 0.08 0.1" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.25 0.3" rgb2="0.12 0.16 0.2"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" size="50 50 0.3" pos="0 0 0" material="groundplane" contype="1" conaffinity="1"/>
    <light name="main_light" pos="0 0 4" dir="0 0 -1" directional="true"/>

    <!-- 仿真深度相机：640x480、fovy 60°，插件按 fovy 反推内参。
         pos 在箱体的 -x 侧、与箱心同高；xyaxes 使光轴指向箱心 (0.35, 0.183, 0.175)：
         X = (0.925, -0.380, 0)、Y = (0, 0, 1)，于是 -Z = (0.380, 0.925, 0)。 -->
    <camera name="vision_camera" pos="0.05 -0.55 0.175"
            xyaxes="0.925 -0.380 0  0 0 1"
            fovy="60" resolution="640 480"/>

    <!--
      目标：边长 0.35 m 的红色立方体，静态落地（无 joint），中心 (0.35, 0.183, 0.175)，
      绕 z 轴逆时针 45°。对相机可见的只有 -X' 面（法线 (-0.707, -0.707, 0)，入射 28.8°），
      它正是任务能抓的那一面；另一面入射 79.9°，超过 65° 门限，追踪器不会锁错。
      group="0" 是显式指定，避免落到上面 default 里的 group 2。
    -->
    <geom name="red_box" type="box" size="0.175 0.175 0.175"
          pos="0.35 0.183 0.175" quat="0.92388 0 0 0.382683"
          rgba="1 0 0 1" group="0"/>
  </worldbody>
</mujoco>
